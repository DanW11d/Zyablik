# Скопируй в .env и впиши свои значения. Файл .env никому не показывай и не коммить в git.

# openrouter (облако, бесплатные модели) или ollama (локально)
LLM_PROVIDER=openrouter

# Ключ из личного кабинета. Для ollama не нужен.
OPENROUTER_API_KEY=

# Модель. Для openrouter выбери бесплатную из списка: python test_llm.py --list-free
# Для ollama, например: gemma4:e2b
LLM_MODEL=

# Запасные модели через запятую, если основная упёрлась в лимит (ошибка 429)
LLM_FALLBACK_MODELS=

# Необязательно: переопределить адрес API (по умолчанию подставляется по провайдеру)
# LLM_BASE_URL=
